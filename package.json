{
  "name": "@map-jr/styles",
  "version": "1.2.0",
  "type": "module",
  "description": "Map styles for map-jr-gl that carry their own icons and road shields, with a light and a dark branch, and MapLibre GL JS versions of them.",
  "keywords": [
    "map",
    "maps",
    "map-style",
    "vector-tiles",
    "openmaptiles",
    "openfreemap",
    "maplibre-style",
    "map-jr-gl",
    "maplibre",
    "dark-mode"
  ],
  "author": "Sam Margulies",
  "license": "MIT AND BSD-3-Clause AND CC-BY-4.0 AND CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/map-jr/map-jr-styles.git"
  },
  "homepage": "https://github.com/map-jr/map-jr-styles#readme",
  "bugs": {
    "url": "https://github.com/map-jr/map-jr-styles/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.json": "./dist/styles/*.min.json",
    "./maplibre/*.json": "./dist/maplibre/*.min.json"
  },
  "files": [
    "dist/styles/*.min.json",
    "dist/maplibre/*.min.json",
    "CHANGELOG.md",
    "NOTICE.md",
    "icons/upstream/LICENSE-*.md",
    "icons/extra/LICENSE-maki.txt",
    "styles/src/openfreemap/LICENSE*.md",
    "styles/src/openfreemap/COMMIT"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@map-jr/map-jr-gl": ">=0.9.0"
  },
  "peerDependenciesMeta": {
    "@map-jr/map-jr-gl": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "apply-edit": "node scripts/apply-edit.mjs",
    "preview": "node test/preview.mjs",
    "upload": "node scripts/publish.mjs",
    "update-shields": "node scripts/update-shields.mjs",
    "update-icons": "node scripts/update-icons.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.8.0",
    "@resvg/resvg-js": "2.6.2",
    "publint": "^0.3.25",
    "svgo": "^4.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}

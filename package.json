{
  "name": "map-jr-styles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Map styles for map-jr-gl with SVG template icons and road shields instead of a sprite sheet.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "apply-edit": "node scripts/apply-edit.mjs",
    "preview": "node test/preview.mjs",
    "upload": "node scripts/publish.mjs",
    "update-shields": "node scripts/update-shields.mjs",
    "update-icons": "node scripts/update-icons.mjs"
  },
  "devDependencies": {
    "svgo": "^4.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
